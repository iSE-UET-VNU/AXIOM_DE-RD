__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.env
.streamlit/

# Keep only the main pipeline configuration under version control.
/configs/*
!/configs/pipeline.yaml

# Local benchmark checkouts and generated probe artifacts.
/ParseBench/
/tmp/
/tests/
/chandra2_technical_summary_for_codex.md
/debug.log

# Local inputs and presigned-URL inventories can contain sensitive data.
data/raw/
data/ingested/*
data/cleaned/*
data/enriched/*
data/embedded/*
data/output/*
data/work/*
data/processed/*

!data/ingested/.gitkeep
!data/cleaned/.gitkeep
!data/enriched/.gitkeep
!data/embedded/.gitkeep
!data/output/.gitkeep

.vscode
.DS_Store

# Isolated interpreter for the local cross-encoder: torch 2.2.2 (the x86-macOS
# ceiling) needs the numpy 1.x ABI, which conflicts with the main env's numpy 2.
.venv-reranker/

# Challenge inputs: the data lake is ~2GB of mixed media and must never be
# committed. Brackets are glob character classes, so the literal name is escaped.
\[iSE Summer Challenge 2026\] Data Lake/
\[iSE Summer Challenge 2026\] Questions*.csv
*.zip

# Archived experiments kept out of the index.
archive/

# ---------------------------------------------------------------------------
# Research, not system. Nothing below is needed to run the pipeline. The
# dependency direction makes this safe: benchmark/ imports src/, never the
# reverse.
# ---------------------------------------------------------------------------
benchmark/
data/benchmark/
data/subset/
scripts/benchmark_report.py
scripts/chunklab_report.py
*.ipynb

# Retrieval artifacts are build output, keyed by config_hash and rebuilt from the
# chunk manifest. The BM25 index over a full corpus is large and derived.
src/retrieval/artifacts/*/
