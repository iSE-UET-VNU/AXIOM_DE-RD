!data/enriched/.gitkeep
!data/embedded/.gitkeep
!data/output/.gitkeep

.vscode
.DS_Store

# Challenge inputs: the data lake is ~2GB of mixed media and must never be
# committed. Brackets are glob character classes, so the literal name is escaped.
\[iSE Summer Challenge 2026\] Data Lake/
\[iSE Summer Challenge 2026\] Questions*.csv
*.zip

# Local corpora and notebooks. Not needed to run the pipeline.
data/subset/
*.ipynb

# ---------------------------------------------------------------------------
# research/ is tracked: it holds the evaluation harness -- corpus build,
# evalset build, retrieval runs, answer generation and judging -- which is how
# every number we report is produced. Unreviewable measurement code is worse
# than none. The dependency direction still holds and is what keeps this safe:
# research/ imports src/, never the reverse.
#
# Its *outputs* stay out. data/benchmark/ holds a 92 MB corpus.jsonl plus run
# files, all derived and rebuildable, and questions.jsonl carries the
# challenge's gold answers.
# ---------------------------------------------------------------------------
data/benchmark/

# Retrieval artifacts are build output, keyed by config_hash and rebuilt from the
# chunk manifest. The BM25 index over a full corpus is large and derived.
src/retrieval/artifacts/*/
