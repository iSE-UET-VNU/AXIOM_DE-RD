{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axiom://schemas/logical-document-v1",
  "contract_version": "logical-document-schema-v1",
  "title": "AXIOM Logical Document",
  "description": "A logical document assembled from the canonical document registry and normalized component JSONL artifacts.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "normalized-document-v1",
      "description": "Version of the document registry record contract."
    },
    "document_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier used to join the document and all components."
    },
    "source_uri": {
      "type": "string",
      "description": "Project-relative URI of the source document."
    },
    "source_format": {
      "type": "string",
      "description": "Source file format without a leading dot."
    },
    "file_name": {
      "type": "string",
      "description": "Source filename."
    },
    "relative_uri": {
      "type": ["string", "null"],
      "description": "Source path relative to the dataset input root."
    },
    "content_type": {
      "type": "string",
      "description": "Source MIME type."
    },
    "size_bytes": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Source file size in bytes."
    },
    "document_type": {
      "type": ["string", "null"],
      "description": "Observed document type."
    },
    "language": {
      "type": ["string", "null"],
      "description": "Dominant ISO 639-1 language when available."
    },
    "title": {
      "type": ["string", "null"],
      "description": "Visible document title when available."
    },
    "page_count": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Number of parsed pages."
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {"type": ["string", "null"]},
        "mode": {"type": ["string", "null"]},
        "status": {"type": ["string", "null"]}
      },
      "required": ["provider", "mode", "status"]
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "has_text": {"type": "boolean"},
        "missing_image_assets": {"type": "integer", "minimum": 0}
      },
      "required": ["has_text", "missing_image_assets"]
    },
    "component_counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "texts": {
          "type": "integer",
          "minimum": 0,
          "description": "Physical text records, including records whose role is formula."
        },
        "tables": {"type": "integer", "minimum": 0},
        "images": {"type": "integer", "minimum": 0},
        "formulas": {"type": "integer", "minimum": 0}
      },
      "required": ["texts", "tables", "images", "formulas"]
    },
    "work_artifact_uri": {
      "type": ["string", "null"],
      "description": "Run-scoped Datalab work bundle URI."
    },
    "texts": {
      "type": "array",
      "description": "Normalized non-formula text components for this document.",
      "items": {"$ref": "#/$defs/text"}
    },
    "tables": {
      "type": "array",
      "description": "Normalized tables for this document.",
      "items": {"$ref": "#/$defs/table"}
    },
    "images": {
      "type": "array",
      "description": "Normalized decoded image assets for this document.",
      "items": {"$ref": "#/$defs/image"}
    },
    "formulas": {
      "type": "array",
      "description": "Normalized text components whose role is formula.",
      "items": {"$ref": "#/$defs/formula"}
    }
  },
  "required": [
    "contract_version",
    "document_id",
    "source_uri",
    "source_format",
    "file_name",
    "relative_uri",
    "content_type",
    "size_bytes",
    "document_type",
    "language",
    "title",
    "page_count",
    "parser",
    "quality",
    "component_counts",
    "work_artifact_uri",
    "texts",
    "tables",
    "images",
    "formulas"
  ],
  "$defs": {
    "text": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {"const": "normalized-text-v1"},
        "text_id": {"type": "string"},
        "document_id": {"type": "string"},
        "source_uri": {"type": "string"},
        "source_block_id": {"type": ["string", "null"]},
        "page": {"type": ["integer", "null"], "minimum": 0},
        "role": {
          "type": "string",
          "not": {"const": "formula"},
          "description": "Text role other than formula."
        },
        "text": {"type": "string", "description": "Actual normalized text content."},
        "embedding_text": {"type": "string"},
        "section_path": {"type": "array", "items": {"type": "string"}},
        "source_artifact": {"type": "string"}
      },
      "required": [
        "contract_version",
        "text_id",
        "document_id",
        "source_uri",
        "source_block_id",
        "page",
        "role",
        "text",
        "embedding_text",
        "section_path",
        "source_artifact"
      ]
    },
    "formula": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {"const": "normalized-text-v1"},
        "text_id": {"type": "string"},
        "document_id": {"type": "string"},
        "source_uri": {"type": "string"},
        "source_block_id": {"type": ["string", "null"]},
        "page": {"type": ["integer", "null"], "minimum": 0},
        "role": {"const": "formula"},
        "text": {"type": "string", "description": "Actual normalized formula text."},
        "embedding_text": {"type": "string"},
        "section_path": {"type": "array", "items": {"type": "string"}},
        "source_artifact": {"type": "string"}
      },
      "required": [
        "contract_version",
        "text_id",
        "document_id",
        "source_uri",
        "source_block_id",
        "page",
        "role",
        "text",
        "embedding_text",
        "section_path",
        "source_artifact"
      ]
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {"const": "normalized-table-v1"},
        "table_id": {"type": "string"},
        "document_id": {"type": "string"},
        "source_uri": {"type": "string"},
        "source_block_id": {"type": ["string", "null"]},
        "page": {"type": ["integer", "null"], "minimum": 0},
        "caption": {"type": "string"},
        "html": {"type": "string"},
        "rows": {
          "type": "array",
          "description": "Actual table cell values by row.",
          "items": {"type": "array", "items": {"type": "string"}}
        },
        "markdown": {"type": "string"},
        "embedding_text": {"type": "string"},
        "row_count": {"type": "integer", "minimum": 0},
        "column_count": {"type": "integer", "minimum": 0},
        "headers": {"type": "array", "items": {"type": "string"}},
        "semantic": {"type": "object", "additionalProperties": true},
        "source_artifact": {"type": "string"}
      },
      "required": [
        "contract_version",
        "table_id",
        "document_id",
        "source_uri",
        "source_block_id",
        "page",
        "caption",
        "html",
        "rows",
        "markdown",
        "embedding_text",
        "row_count",
        "column_count",
        "headers",
        "semantic",
        "source_artifact"
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {"const": "normalized-image-v1"},
        "image_id": {"type": "string"},
        "document_id": {"type": "string"},
        "source_uri": {"type": "string"},
        "source_block_id": {"type": ["string", "null"]},
        "page": {"type": ["integer", "null"], "minimum": 0},
        "image_name": {"type": "string"},
        "image_path": {"type": "string"},
        "visible_caption": {"type": "string"},
        "generated_description": {"type": "string"},
        "caption_is_visible": {"type": "boolean"},
        "description_source": {"type": ["string", "null"]},
        "embedding_text": {"type": "string"},
        "semantic": {"type": "object", "additionalProperties": true},
        "source_artifact": {"type": "string"}
      },
      "required": [
        "contract_version",
        "image_id",
        "document_id",
        "source_uri",
        "source_block_id",
        "page",
        "image_name",
        "image_path",
        "visible_caption",
        "generated_description",
        "caption_is_visible",
        "description_source",
        "embedding_text",
        "semantic",
        "source_artifact"
      ]
    }
  },
  "x-axiom-dataset": {},
  "x-axiom-storage": {},
  "x-axiom-provenance": {}
}
