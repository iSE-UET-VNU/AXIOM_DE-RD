# Required only when parsing.document.provider is "lift_api".
DATALAB_API_KEY=

# Chandra2 remote inference (chandra2.method="vllm").
VLLM_API_BASE=http://localhost:8000/v1
VLLM_MODEL_NAME=chandra
VLLM_API_KEY=EMPTY

# Chandra2 direct local inference (chandra2.method="hf").
MODEL_CHECKPOINT=datalab-to/chandra-ocr-2
# Leave empty for device_map="auto"; set cuda only when the GPU has enough VRAM.
TORCH_DEVICE=
# Optional, for example flash_attention_2 when installed and supported.
TORCH_ATTN=

# Required only when indexing.embeddings.provider is "openrouter".
OPENROUTER_API_KEY=
# Optional OpenRouter attribution headers.
OPENROUTER_HTTP_REFERER=

# Required only when storage.vector_db.provider is "milvus".
MILVUS_URI=
MILVUS_TOKEN=
