# S3 object read by src/s3_reader.py through the standard boto3 credential chain.
S3_URI=s3://bucket/path/to/document.pdf
# AWS_PROFILE=default
# AWS_REGION=ap-southeast-1
# Optional for MinIO or another S3-compatible service.
# S3_ENDPOINT_URL=http://localhost:9000
# Used to select one object when s3.info.txt contains multiple presigned URLs.
# S3_OBJECT_KEY=path/to/document.pdf

# Required only when configs/pipeline.yaml sets parsing.provider to "lift_api".
DATALAB_API_KEY=

# Chandra2 / OCR remote inference (used by enrich branch and kdl)
# Can set either CHANDRA_ENDPOINT or VLLM_API_BASE:
CHANDRA_ENDPOINT=http://localhost:8000/v1
VLLM_API_BASE=http://localhost:8000/v1
CHANDRA_MODEL=datalab-to/chandra-ocr-2
VLLM_MODEL_NAME=chandra
VLLM_API_KEY=EMPTY

# ColPali / ColVec remote visual reranking endpoint (optional)
# COLPALI_ENDPOINT=http://localhost:8001/v1

# Chandra2 direct local inference (chandra2.method="hf").
MODEL_CHECKPOINT=datalab-to/chandra-ocr-2
# Leave empty for device_map="auto"; set cuda only when the GPU has enough VRAM.
TORCH_DEVICE=
# Optional, for example flash_attention_2 when installed and supported.
TORCH_ATTN=

# LLM / Vision API configuration (OpenRouter or OpenAI)
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# Optional custom base URL for OpenAI-compatible proxies (LiteLLM, vLLM, Ollama)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional OpenRouter attribution headers.
OPENROUTER_HTTP_REFERER=

# TableAgent service used for spreadsheet ingestion. TableAgent should listen
# on a different port from the AXIOM API.
TABLE_AGENT_BASE_URL=http://127.0.0.1:8001
# Optional; must match TableAgent's TABLE_AGENT_SERVICE_API_KEY when enabled.
TABLE_AGENT_SERVICE_API_KEY=
