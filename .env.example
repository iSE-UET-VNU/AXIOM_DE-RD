# S3 object read by src/s3_reader.py through the standard boto3 credential chain.
S3_URI=s3://bucket/path/to/document.pdf
# AWS_PROFILE=default
# AWS_REGION=ap-southeast-1
# Optional for MinIO or another S3-compatible service.
# S3_ENDPOINT_URL=http://localhost:9000
# Used to select one object when s3.info.txt contains multiple presigned URLs.
# S3_OBJECT_KEY=path/to/document.pdf

# Required only when configs/pipeline.yaml sets parsing.provider to "lift_api".
DATALAB_API_KEY=

# Required only when indexing.embeddings.provider is "openrouter".
OPENROUTER_API_KEY=
# Optional OpenRouter attribution headers.
OPENROUTER_HTTP_REFERER=

# TableAgent service used for spreadsheet ingestion. TableAgent should listen
# on a different port from the AXIOM API.
TABLE_AGENT_BASE_URL=http://127.0.0.1:8001
# Optional; must match TableAgent's TABLE_AGENT_SERVICE_API_KEY when enabled.
TABLE_AGENT_SERVICE_API_KEY=
