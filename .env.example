# S3 object read by src/s3_reader.py through the standard boto3 credential chain.
S3_URI=s3://bucket/path/to/document.pdf
# AWS_PROFILE=default
# AWS_REGION=ap-southeast-1
# Optional for MinIO or another S3-compatible service.
# S3_ENDPOINT_URL=http://localhost:9000
# Used to select one object when s3.info.txt contains multiple presigned URLs.
# S3_OBJECT_KEY=path/to/document.pdf

# Required only when configs/pipeline.yaml sets parsing.provider to "lift_api".
DATALAB_API_KEY=

# Chandra2 remote inference (chandra2.method="vllm").
VLLM_API_BASE=http://localhost:8000/v1
VLLM_MODEL_NAME=chandra
VLLM_API_KEY=EMPTY

# pdf-inspsector + KDL
AXIOM_PIPELINE_CONFIG=configs/pipeline.kdl-pdf-inspector.yaml
KDL_NANO_ENDPOINT_URL=http://kdl-model-service:8000/v1
KDL_NANO_MODEL=kdl-frontier-parser-nano
KDL_NANO_API_KEY=EMPTY

# Chandra2 direct local inference (chandra2.method="hf").
MODEL_CHECKPOINT=datalab-to/chandra-ocr-2
TORCH_DEVICE=
TORCH_ATTN=

# OPEN ROUTER API Key
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=
